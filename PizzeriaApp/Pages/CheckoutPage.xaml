<Page x:Class="PizzeriaApp.Pages.CheckoutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Оплата">
    <Grid Margin="30">
        <Border Width="520" Padding="25" BorderBrush="Gray" BorderThickness="1"
                CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Оформление заказа" FontSize="26" FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <TextBlock x:Name="OrderInfoTextBlock" TextWrapping="Wrap"
                           Margin="0,0,0,15"/>

                <TextBlock x:Name="TotalTextBlock" FontSize="22" FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Способ оплаты"/>
                <ComboBox x:Name="PaymentMethodComboBox" Height="32" Margin="0,5,0,15"
                          DisplayMemberPath="Name"
                          SelectionChanged="PaymentMethodComboBox_SelectionChanged"/>

                <StackPanel x:Name="CashPanel" Visibility="Collapsed">
                    <TextBlock Text="Внесённая сумма"/>
                    <TextBox x:Name="CashReceivedTextBox" Height="32" Margin="0,5,0,5"
                             TextChanged="CashReceivedTextBox_TextChanged"/>
                    <TextBlock x:Name="ChangeTextBlock" FontWeight="Bold"
                               Margin="0,0,0,15"/>
                </StackPanel>

                <Button Content="Оплатить и сохранить заказ" Height="42"
                        Click="SaveOrderButton_Click"/>
                <Button Content="Отмена" Height="38" Margin="0,10,0,0"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
