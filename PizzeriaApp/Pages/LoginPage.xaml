<Page x:Class="PizzeriaApp.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация">
    <Grid Margin="30">
        <Border Width="420" Padding="25" BorderBrush="Gray" BorderThickness="1"
                CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Вход в пиццерию" FontSize="26" FontWeight="Bold"
                           Margin="0,0,0,20"/>
                <TextBlock Text="Логин"/>
                <TextBox x:Name="LoginTextBox" Height="32" Margin="0,5,0,12"/>

                <TextBlock Text="Пароль"/>
                <PasswordBox x:Name="PasswordBox" Height="32" Margin="0,5,0,20"/>

                <Button Content="Войти" Height="38" Click="LoginButton_Click"/>
                <Button Content="Регистрация" Height="38" Margin="0,10,0,0"
                        Click="RegisterButton_Click"/>

                <TextBlock Margin="0,18,0,0" Foreground="Gray"
                           Text="Тест: admin / admin123"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
