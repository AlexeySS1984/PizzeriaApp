<Page x:Class="PizzeriaApp.Pages.CombosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Готовые комбо">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="HelloTextBlock" FontSize="24" FontWeight="Bold"/>
            <Button Content="Выйти" Width="90" Height="32"
                    HorizontalAlignment="Right" DockPanel.Dock="Right"
                    Click="LogoutButton_Click"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Сортировка по цене:" VerticalAlignment="Center"/>
            <ComboBox x:Name="SortComboBox" Width="190" Height="30" Margin="10,0,0,0"
                      SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem Content="Сначала дешевле"/>
                <ComboBoxItem Content="Сначала дороже"/>
            </ComboBox>
        </StackPanel>

        <DataGrid x:Name="CombosDataGrid" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Комбо" Binding="{Binding Name}" Width="170"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="220"/>
                <DataGridTextColumn Header="Состав" Binding="{Binding Composition}" Width="*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2} ₽}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Собрать свой заказ" Width="190" Height="40"
                    Click="BuildOrderButton_Click"/>
            <Button Content="Заказать выбранное комбо" Width="220" Height="40"
                    Margin="10,0,0,0" Click="OrderComboButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
