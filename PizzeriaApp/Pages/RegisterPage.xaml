<Page x:Class="PizzeriaApp.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация">
    <Grid Margin="30">
        <Border Width="440" Padding="25" BorderBrush="Gray" BorderThickness="1"
                CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Регистрация" FontSize="26" FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Имя"/>
                <TextBox x:Name="NameTextBox" Height="32" Margin="0,5,0,12"/>

                <TextBlock Text="Логин"/>
                <TextBox x:Name="LoginTextBox" Height="32" Margin="0,5,0,12"/>

                <TextBlock Text="Пароль"/>
                <PasswordBox x:Name="PasswordBox" Height="32" Margin="0,5,0,12"/>

                <TextBlock Text="Повторите пароль"/>
                <PasswordBox x:Name="RepeatPasswordBox" Height="32" Margin="0,5,0,20"/>

                <Button Content="Зарегистрироваться" Height="38"
                        Click="RegisterButton_Click"/>
                <Button Content="Назад" Height="38" Margin="0,10,0,0"
                        Click="BackButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
